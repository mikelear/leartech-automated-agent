{
  "uid": "leartech-agent-runs",
  "title": "Leartech — Agent Runs",
  "tags": ["leartech", "agents", "loki"],
  "editable": true,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ns",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(namespace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "jx-staging", "value": "jx-staging" }
      },
      {
        "name": "run",
        "label": "Run / pod",
        "description": "Run pod label. Restricted to agent-run Job pods (Job name is the 12-hex `run_id` from `app.state.new_id`; K8s appends a 5-char suffix so pod names match `^[0-9a-f]{12}-[a-z0-9]{5}$`). This avoids enumerating every pod in the namespace. Deprecated — prefer $run_id (structured field) below.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({namespace=\"$ns\", pod=~\"[0-9a-f]{12}-[a-z0-9]{5}\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "[0-9a-f]{12}-[a-z0-9]{5}",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "run_id",
        "label": "Run id",
        "description": "Structured `run_id` field (from obslog ambient context). Scoped to agent-run Job pods (`^[0-9a-f]{12}-[a-z0-9]{5}$`) so the lookup doesn't scan the whole namespace.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({namespace=\"$ns\", pod=~\"[0-9a-f]{12}-[a-z0-9]{5}\"} |~ \"run_id\" | json | run_id=~\".+\", run_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Tier 3 — Agent run (deepest drill-down)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "run_start count (window)",
      "description": "Structured `event=run_start` count in the dashboard window — how many agent runs kicked off. Uses `| json | event=\"run_start\"` (with `|~ \"run_start\"` line-prefilter for performance and graceful degradation on non-JSON streams).",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"run_start\" | json | event=\"run_start\" | run_id=~\"$run_id\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "run_end exit_code=0 (green)",
      "description": "Count of `event=run_end` with `exit_code=0`. This is the success count — should match run_start when runs are steady-state healthy.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"run_end\" | json | event=\"run_end\" | exit_code=\"0\" | run_id=~\"$run_id\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "run_end exit_code!=0 (red)",
      "description": "Count of `event=run_end` with a non-zero `exit_code`. This is the failure count.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"run_end\" | json | event=\"run_end\" | exit_code!=\"0\" | run_id=~\"$run_id\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total cost USD (window)",
      "description": "Sum of `cost_usd` field across all `run_end` events. `| unwrap cost_usd` extracts the numeric field from JSON. Non-JSON lines are silently skipped by the unwrap.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 } ] },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(sum_over_time({namespace=\"$ns\"} |~ \"run_end\" | json | event=\"run_end\" | run_id=~\"$run_id\" | unwrap cost_usd [$__range]))", "instant": true }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Run outcomes (structured run_end) — exit_code, targetPR, turns, cost",
      "description": "The authoritative per-run outcome line — parsed via `| json`, filtered on `event=\"run_end\"`. Every line carries `exit_code`, `reason`, `targetPR`, `turns`, `cost_usd`. This is the first stop for 'did this run succeed and why'. Line-prefilter `|~ \"run_end\"` narrows the stream before parsing.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\"} |~ \"run_end\" | json | event=\"run_end\" | run_id=~\"$run_id\"" }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Agent run logs — $run / $run_id",
      "description": "Live + historical logs for the selected agent run(s). Survives pod GC (Loki-backed) — the durable replacement for `kubectl logs`. Kept as a raw stream (no `| json`) so pre-structured lines still show; use panel-6 for structured drill-down.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 16 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\", pod=~\"$run\"}" }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "MCP / open_pr / tool activity (structured)",
      "description": "Lines whose logger names an MCP or the PR-capture path — filtered structurally via `| json | logger=~\".*(mcp|pr_context|initiative).*\"` OR by explicit `tool` field. Fallback line-filter `|~ \"open_pr|mcp__|targetPR|leartech-pr-context\"` catches unstructured lines so a stream still surfaces even if not yet JSON.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 27 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\", pod=~\"$run\"} |~ \"(open_pr|mcp__|targetPR|leartech-pr-context)\" | json | run_id=~\"$run_id\"" }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Errors & failures (structured level=ERROR)",
      "description": "Structured `| json | level=\"ERROR\"` — the authoritative error stream. Falls back to `|~ \"error|traceback|exception|failed|401|403|404\"` when the line isn't JSON so nothing hides.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 27 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\", pod=~\"$run\"} | json | level=\"ERROR\" | run_id=~\"$run_id\"" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\", pod=~\"$run\"} !~ \"\\\"level\\\"\" |~ \"(?i)error|traceback|exception|failed|\\\\b(401|403|404)\\\\b\"" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Log volume by pod",
      "description": "Per-pod log rate — spot busy/looping runs.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (pod) (count_over_time({namespace=\"$ns\", pod=~\"$run\"}[$__interval]))", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "MCP tool_call mentions (window)",
      "description": "Count of structured `event=\"tool_call\"` OR `event=\"tool_result\"` lines — MCP activity through this pod. Falls back to substring `open_pr` for streams pre-JSON.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 36 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"tool_call|tool_result|open_pr\" | json | event=~\"tool_(call|result)\" | run_id=~\"$run_id\" [$__range]))", "instant": true, "legendFormat": "structured" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\", pod=~\"$run\"} !~ \"\\\"event\\\":\\\"tool_\" |~ \"(?i)open_pr\" [$__range]))", "instant": true, "legendFormat": "fallback (line-filter)" }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Turns (sum across window)",
      "description": "Sum of `turns` from `run_end` events — the total number of SDK turns consumed. High = expensive runs.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 40 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 100 } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(sum_over_time({namespace=\"$ns\"} |~ \"run_end\" | json | event=\"run_end\" | run_id=~\"$run_id\" | unwrap turns [$__range]))", "instant": true }
      ]
    }
  ]
}
