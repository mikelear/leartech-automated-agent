{
  "uid": "leartech-plans",
  "title": "Leartech — Plans",
  "tags": ["leartech", "plans", "loki"],
  "editable": true,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ns",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(namespace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "jx-staging", "value": "jx-staging" }
      },
      {
        "name": "plan",
        "label": "Plan",
        "description": "Plan name (extracted from the maestro plan.* event stream). Scoped to the maestro app label so the lookup doesn't scan the whole namespace.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.\" | json | plan=~\".+\", plan)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Tier 1 — Plans (event-sourced from maestro `eventName=plan.*`)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Plans succeeded (window)",
      "description": "Count of `eventName=plan.completed` events with phase=Succeeded in the dashboard time-range. Queried against the maestro stream (which is where the plan.* lifecycle events are actually emitted) — NOT the controller stream (whose plan.completed lines are per-cluster debug, not the lifecycle source of truth).",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.completed\" | json | eventName=\"plan.completed\" | phase=~\"(?i)succeeded|success\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Plans failed (window)",
      "description": "Count of `eventName=plan.completed` events with phase=Failed in the dashboard time-range (maestro stream).",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.completed\" | json | eventName=\"plan.completed\" | phase=~\"(?i)failed|failure\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Plans resolved (window)",
      "description": "Count of `eventName=plan.completed` events with phase=Resolved (the BA-loop closure phase) in the dashboard time-range (maestro stream).",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.completed\" | json | eventName=\"plan.completed\" | phase=~\"(?i)resolved\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Plans in flight",
      "description": "Distinct plans with `eventName=plan.step_started` in the window (proxy for currently-active plans). Zero-boundary means idle.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "count(count by (plan) (count_over_time({namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.step_started\" | json | eventName=\"plan.step_started\" [$__range])))", "instant": true }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent plan lifecycle events",
      "description": "All `plan.*` events (step_started / step_done / completed) from the maestro stream, reverse-chronological. Filter by $plan to focus a single plan. Line-prefilter `|~ \"plan\\\\.\"` narrows the stream before JSON parsing.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.(step_started|step_done|completed)\" | json | eventName=~\"plan\\\\.(step_started|step_done|completed)\" | plan=~\"$plan\"" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Plan step throughput (steps started/done over time)",
      "description": "Per-event rate of `plan.step_started` vs `plan.step_done` — a widening gap between started and done indicates piling-up in-flight steps. Sourced from the maestro `eventName=` field.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } }, "noValue": "0" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.step_started\" | json | eventName=\"plan.step_started\" | plan=~\"$plan\" [$__interval]))", "legendFormat": "step_started" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.step_done\" | json | eventName=\"plan.step_done\" | plan=~\"$plan\" [$__interval]))", "legendFormat": "step_done" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Plan.completed by phase",
      "description": "Rate of terminal `plan.completed` events broken out by phase (Succeeded / Failed / Resolved). Sourced from the maestro `eventName=` field.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } }, "noValue": "0" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (phase) (count_over_time({namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.completed\" | json | eventName=\"plan.completed\" | plan=~\"$plan\" [$__interval]))", "legendFormat": "{{phase}}" }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Per-step timeline for $plan",
      "description": "Filtered to $plan — `plan.step_started` and `plan.step_done` with `step` + `phase`, one line per hop. Sourced from the maestro stream via `eventName=`. Use this as the plan's audit log; each line's JSON details expose the step's inputs/outcome.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 26 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Ascending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\", app=\"leartech-maestro-service\"} |~ \"plan\\\\.(step_started|step_done)\" | json | eventName=~\"plan\\\\.step_(started|done)\" | plan=~\"$plan\"" }
      ]
    }
  ]
}
