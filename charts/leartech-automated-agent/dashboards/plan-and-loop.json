{
  "uid": "leartech-plan-and-loop",
  "title": "Leartech — Event→BA Loop",
  "tags": ["leartech", "loop", "ba", "maestro", "loki"],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ns",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(namespace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "jx-staging", "value": "jx-staging" }
      },
      {
        "name": "event_id",
        "label": "Event id",
        "description": "Correlates mid-loop hops (maestro_receive → resolved). Optional — leave as `.+` to see all loops.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({namespace=\"$ns\"} |~ \"loop_hop\" | json | event_id=~\".+\", event_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "plan",
        "label": "Plan",
        "description": "Correlates the outer boundaries of a loop (emit + resolved carry `plan`, not event_id). Optional — leave as `.+` for all.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({namespace=\"$ns\"} |~ \"loop_hop\" | json | plan=~\".+\", plan)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Tier 2 — Event→BA Loop (release.deploy_failed → remediation_authored → resolved)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "release.deploy_failed emitted",
      "description": "Count of loop `emit` hops (release.deploy_failed) in the window. This is what starts the loop.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"emit\" | plan=~\"$plan\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Loops resolved",
      "description": "Count of loop `resolved` hops (loop closure) in the window.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"resolved\" | plan=~\"$plan\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Remediations authored",
      "description": "Count of loop `remediation_authored` hops — the BA agent finished writing a remediation.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"remediation_authored\" | plan=~\"$plan\" [$__range]))", "instant": true }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Loop-closure ratio (resolved / emit)",
      "description": "Fraction of `release.deploy_failed` emits that reached `resolved` in the window. Under 1.0 = open loops. Over 1.0 = late resolutions of loops emitted before the window.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 1 } ] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"resolved\" | plan=~\"$plan\" [$__range])) / clamp_min(sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"emit\" | plan=~\"$plan\" [$__range])), 1)", "instant": true }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Loop trace — hops in time order (filter by $event_id / $plan)",
      "description": "The headline panel. Every loop hop — emit → maestro_receive → maestro_dispatch → consume → ba_spawn → remediation_authored → resolved — in time order. Correlate mid-loop hops by $event_id; the outer emit + resolved carry `plan` so also filter by $plan when needed. Line-prefilter `|~ \"loop_hop\"` narrows the stream before JSON parsing.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 6 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Ascending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=~\".+\" | event_id=~\"$event_id\" | plan=~\"$plan\"" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "release.deploy_failed rate over time",
      "description": "Rate of loop-opening `emit` hops (the release.deploy_failed events reaching maestro). Spikes = surge of deploy failures; steady baseline = normal reconcile pressure.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "none" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"emit\" | plan=~\"$plan\" [$__interval]))", "legendFormat": "release.deploy_failed" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Resolve outcomes: resolved vs emitted (over time)",
      "description": "Side-by-side rate of `emit` and `resolved` hops. If `resolved` trails `emit` persistently, loops are hanging.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"emit\" | plan=~\"$plan\" [$__interval]))", "legendFormat": "emit" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"resolved\" | plan=~\"$plan\" [$__interval]))", "legendFormat": "resolved" }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Per-hop coverage — a missing hop should be obvious",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "emit",
      "description": "Loop-start hop. Ties to `release.deploy_failed`. Missing → nothing is publishing the event.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"emit\" | plan=~\"$plan\" [$__range]))", "instant": true, "legendFormat": "emit" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "maestro_receive",
      "description": "Maestro received the event. Missing → maestro isn't subscribed / topic misrouting.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 29 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"maestro_receive\" | event_id=~\"$event_id\" [$__range]))", "instant": true, "legendFormat": "maestro_receive" }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "maestro_dispatch",
      "description": "Maestro dispatched to a subscriber (typically consume/ba_spawn). Missing after receive → no matching subscription.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 29 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"maestro_dispatch\" | event_id=~\"$event_id\" [$__range]))", "instant": true, "legendFormat": "maestro_dispatch" }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "consume",
      "description": "Subscriber pulled the message off the bus. Missing after dispatch → consumer is unhealthy / backlogged.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 29 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"consume\" | event_id=~\"$event_id\" [$__range]))", "instant": true, "legendFormat": "consume" }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "ba_spawn",
      "description": "BA agent Job spawned. Missing after consume → jobspawn error / RBAC drop.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 29 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"ba_spawn\" | event_id=~\"$event_id\" [$__range]))", "instant": true, "legendFormat": "ba_spawn" }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "remediation_authored",
      "description": "BA finished authoring a remediation Plan. Missing after ba_spawn → BA crashed or exited non-zero.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 29 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"remediation_authored\" | event_id=~\"$event_id\" [$__range]))", "instant": true, "legendFormat": "remediation_authored" }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "resolved",
      "description": "Loop closure — the remediation Plan reached a terminal Succeeded/Resolved phase. Missing → loop never closed.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 29 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({namespace=\"$ns\"} |~ \"loop_hop\" | json | loop_hop=\"resolved\" | plan=~\"$plan\" [$__range]))", "instant": true, "legendFormat": "resolved" }
      ]
    },
    {
      "id": 17,
      "type": "logs",
      "title": "loop-forensics quick-view — hops for $event_id (verbose JSON)",
      "description": "Mirror of `scripts/loop-forensics.sh` output — same hop vocabulary, filtered to $event_id, showing every field the log line carried. Use to diagnose a specific stuck loop.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Ascending" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{namespace=\"$ns\"} |~ \"loop_hop|event_id\" | json | loop_hop=~\".+\" | event_id=~\"$event_id\"" }
      ]
    }
  ]
}
