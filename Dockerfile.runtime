ARG BASE_IMAGE=ghcr.io/mikelear/leartech-agent-base:0.49.30
FROM $BASE_IMAGE

LABEL org.opencontainers.image.source="https://github.com/mikelear/leartech-automated-agent" \
      org.opencontainers.image.description="Agent runtime layer: Python deps + gate code"

USER root

COPY --from=ghcr.io/astral-sh/uv:0.12.9@sha256:8b940d3a9d65bed080436972241af2e21c84b5e8c9193f7014ed71479ee795ff /uv /usr/local/bin/uv

RUN id -u agent >/dev/null 2>&1 \
    || (groupadd -r agent \
        && useradd -r -g agent -u 1000 -m -d /home/agent agent)
RUN mkdir -p /home/agent && chown agent:agent /home/agent

WORKDIR /app

COPY --chown=agent:agent pyproject.toml uv.lock* ./
COPY --chown=agent:agent gate/ gate/
COPY --chown=agent:agent initiatives/ initiatives/
COPY --chown=agent:agent README.md ./

ENV UV_FROZEN=true
# rm -rf is load-bearing: it discards any inherited or half-written .venv, and it
# changes this RUN's command string so kaniko cannot serve a poisoned cached layer.
RUN rm -rf /app/.venv \
    && uv sync --frozen --no-cache --no-dev \
    && test -x /app/.venv/bin/python \
    && /app/.venv/bin/python -c "import click, gate"

ENV UV_CACHE_DIR=/tmp/uv-cache
ENV LEARTECH_REPO_ROOT=/workspace
ENV PATH="/app/.venv/bin:$PATH"

USER agent
