ARG BASE_IMAGE=ghcr.io/mikelear/leartech-agent-base:0.30.1
FROM $BASE_IMAGE

LABEL org.opencontainers.image.source="https://github.com/mikelear/leartech-automated-agent" \
      org.opencontainers.image.description="Agent runtime layer: Python deps + gate code on leartech-agent-base"

COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /usr/local/bin/uv

RUN groupadd -r agent && useradd -r -g agent -u 1000 agent \
    && mkdir -p /home/agent \
    && chown agent:agent /home/agent

WORKDIR /app

COPY --chown=agent:agent pyproject.toml uv.lock* ./
COPY --chown=agent:agent gate/ gate/
COPY --chown=agent:agent initiatives/ initiatives/
COPY --chown=agent:agent README.md ./

ENV UV_FROZEN=true
RUN uv sync --frozen --no-cache --no-dev 2>/dev/null || uv sync --no-cache --no-dev

ENV UV_CACHE_DIR=/tmp/uv-cache
ENV LEARTECH_REPO_ROOT=/workspace
ENV PATH="/app/.venv/bin:$PATH"

USER agent

# No ENTRYPOINT — this image is a base for variants. They set their own.
# No EXPOSE — this image is a base; variants/API expose ports.
